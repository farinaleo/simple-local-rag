# ==============================================================
# simple-local-rag — configuration
# Copy this file to .env and adjust. Never commit .env !
#   cp .env.example .env
# ==============================================================

# --- Hugging Face ---------------------------------------------------------
# Access token (https://huggingface.co/settings/tokens).
# NOT required for public models like Qwen3-0.6B.
# Required for gated/private models and to avoid rate limits.
HF_TOKEN=

# --- Models ---------------------------------------------------------------
# Generation model (causal LM)
MODEL_NAME=Qwen/Qwen3-0.6B
# Embedding model (alternative: sentence-transformers/all-MiniLM-L6-v2)
EMBED_NAME=Qwen/Qwen3-Embedding-0.6B

# --- Paths ----------------------------------------------------------------
# Knowledge base (.txt files) and persistent vector index
DOCS_DIR=docs
CHROMA_PATH=chroma_db

# --- Retrieval ------------------------------------------------------------
TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Generation -----------------------------------------------------------
MAX_NEW_TOKENS=512
# true = Qwen3 thinking mode (slower); false = fast grounded QA
ENABLE_THINKING=false
