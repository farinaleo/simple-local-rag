# Environment configuration for the RAG API.
# Copy to .env and adjust. Real environment variables take precedence.

# Django
DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (consumed as DATABASE_URL by the settings module)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag

# Celery (Redis broker for the ingestion worker)
CELERY_BROKER_URL=redis://localhost:6379/0
