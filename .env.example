# Central environment configuration for the whole project.
# Copy to .env at the repository root and adjust; real environment
# variables always take precedence over the values in this file.

# --- Django (api + worker) ----------------------------------------------------
DEBUG=true
SECRET_KEY=change-me-in-production
# API version reported in the OpenAPI schema (info.version)
# API_VERSION=4.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,api,nginx

# --- Admin bootstrap (v4 roles, applied by the migrations) ------------------------
# Used once by the accounts data migration to create (or promote) the
# first admin account. Change the password after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# --- PostgreSQL ----------------------------------------------------------------
# Used by compose for the postgres service and to build DATABASE_URL.
POSTGRES_PASSWORD=postgres

# --- Celery (redis broker) ------------------------------------------------------

# --- Hugging Face ---------------------------------------------------------------
# Optional: authenticated model downloads at build time (higher rate limits).
HF_TOKEN=

# --- Inference device -------------------------------------------------------------
# auto (default) | cpu | cuda. With cuda, start compose with the gpu overlay
# (see compose.gpu.yml and the README GPU section).
RAG_DEVICE=auto

# --- CORS (comma-separated origins allowed to call the API) ---------------------
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- CSRF (comma-separated origins allowed to post forms) ----------------------
# Add every origin browsers will use, e.g. http://192.168.1.146:8080 for LAN access.
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
